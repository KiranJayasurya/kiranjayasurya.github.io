@article{ghosh_photometric_2026,
	title = {Photometric and late-time spectropolarimetric observations of {GRB} {250129A} afterglow},
	volume = {551},
	issn = {0035-8711},
	url = {https://doi.org/10.1093/mnras/stag1391},
	doi = {10.1093/mnras/stag1391},
	abstract = {Gamma-ray burst (GRB) afterglows arise from the interaction of relativistic ejecta with the circumburst medium and are observed across the electromagnetic spectrum. Afterglow polarization is expected at early and late afterglow phases depending on the presence of reverse shocks (RS) and the observer’s viewing geometry relative to the jet. Polarimetric observations of GRB afterglows serve as a unique diagnostic tool to investigate the geometry and structure of magnetic fields in the emitting region, which cannot be directly inferred from photometric or spectroscopic data alone. We report late-time (\${\textbackslash}sim\$ 19 h post-burst) spectropolarimetric observations of GRB 250129A using the Southern African Large Telescope. The data reveal a hint of linear polarization, but rotation in polarization angle across wavelengths is not observed. Polarization is usually expected during the early afterglow (\${\textbackslash}lesssim\$ 100 s) when the RS dominates. However, multiwavelength modelling of GRB 250129A data shows no indication of RS contribution during the late epoch. Afterglow model incorporating both the forward shock and RS confirms that RS component fades rapidly after \${\textbackslash}sim\$100 s. The afterglow emission is best explained by an off-axis viewing geometry of a jet with Gaussian core and wing evolving in a uniform density environment. GRB 250129A thus provides a rare observational evidence linking late-time polarization to geometric and jet-structure effects.},
	number = {2},
	urldate = {2026-10-09},
	journal = {Monthly Notices of the Royal Astronomical Society},
	author = {Ghosh, A and Razzaque, S and Barnard, J and Joshi, Jagdish C and Gupta, R and Buckley, D A H and van Soelen, B and Dukiya, N and Gupta, A and Moskvitin, A S and Cooper, J and Chandra, S and Jayasurya, K M and Misra, K and Rawat, N and Resmi, L and Spiridonova, O I and Uklein, R I},
	month = sep,
	year = {2026},
	pages = {stag1391},
	file = {Full Text PDF:/Users/kiranjayasurya/Zotero/storage/MHV6KL3W/Ghosh et al. - 2026 - Photometric and late-time spectropolarimetric observations of GRB 250129A afterglow.pdf:application/pdf;Snapshot:/Users/kiranjayasurya/Zotero/storage/K5LX7XU2/stag1391.html:text/html},
}

@misc{ghosh_exploring_2026,
	title = {Exploring the multi-wavelength properties of the high energetic event {ZTF20abbiixp}/{GRB} {200524A}: from prompt emission to afterglow},
	shorttitle = {Exploring the multi-wavelength properties of the high energetic event {ZTF20abbiixp}/{GRB} {200524A}},
	url = {http://arxiv.org/abs/2608.09704},
	doi = {10.48550/arXiv.2608.09704},
	abstract = {We conducted a comprehensive multi-wavelength analysis of a high energetic long-duration ZTF20abbiixp / GRB{\textasciitilde}200524A detected by {\textbackslash}textit\{Fermi\} Gamma Ray Burst Monitor (GBM). Our study combines extended high-energy observations from multiple space-based observatories including {\textbackslash}textit\{Fermi\} with broadband afterglow data spanning X-ray to radio wavelengths, complemented by extensive photometric and spectroscopic follow-up from several ground-based optical facilities worldwide like 3.6-m Devasthal Optical Telescope (DOT). ZTF20abbiixp / GRB{\textasciitilde}200524A exhibits almost negligible spectral lag, likely arising from the presence of multiple overlapping emission episodes, a property uncommon among long-duration bursts. The burst additionally shows a clear intensity-tracking evolution of the prompt-emission spectral parameters. The broadband afterglow light curve best fits with a broken powerlaw with a break at \$10{\textasciicircum}\{5\}\$ s since the GBM trigger. The electron powerlaw index (p) calculated from the temporal and spectral slopes fail to distinguish between a interstellar medium and a wind environment. Our custom-developed afterglow model fits the panchromatic data well, combining forward shock (FS) and reverse shock (RS) emission. The RS contribution required to fit the early time optical data. The inferred afterglow model parameters suggest that ZTF20abbiixp / GRB{\textasciitilde}200524A is a high energetic burst expanding into a dense ISM environment, with a relatively large value of the fraction of energy going to accelerating electron and magnetic field (\$ε\_B\$).},
	urldate = {2026-10-09},
	publisher = {arXiv},
	author = {Ghosh, A. and Dimple and Misra, K. and Minaev, P. Yu and Yao, Y. and Kann, D. A. and Blazek, M. and Pozanenko, A. S. and Belkin, S. and Izzo, L. and Kumar, H. and Postigo, A. de Ugarte and Rossi, A. and Anupama, G. C. and Bhalerao, V. and Bhattacharya, D. and Chakradhari, N. K. and Chandra, S. and Gupta, R. and Jayasurya, K. M. and Kumar, A. and Kumar, B. and Kumar, T. S. and Moskvitin, A. and Pandey, S. B. and Omar, A. and Rao, A. R. and Resmi, L. and Rumyantsev, V. and Sanwal, P. and Volnova, A. V. and Novichonok, A. O. and Krugov, M. and Ehgamberdiev, S. A. and Volvach, A. E.},
	month = aug,
	year = {2026},
	note = {arXiv:2608.09704 [astro-ph.HE]},
	keywords = {Astrophysics - High Energy Astrophysical Phenomena},
	annote = {Comment: Submitted in MNRAS},
	file = {Preprint PDF:/Users/kiranjayasurya/Zotero/storage/TFVQEI75/Ghosh et al. - 2026 - Exploring the multi-wavelength properties of the high energetic event ZTF20abbiixpGRB 200524A from.pdf:application/pdf;Snapshot:/Users/kiranjayasurya/Zotero/storage/VXED7GLU/2608.html:text/html},
}

@article{jayasurya_discovery_2026,
	title = {Discovery of a {Candidate} 2 {keV} {Cyclotron} {Resonance} {Scattering} {Feature} in the {HLX} {NGC} 3583 {X}-1},
	volume = {1007},
	issn = {0004-637X},
	url = {https://doi.org/10.3847/1538-4357/ae8522},
	doi = {10.3847/1538-4357/ae8522},
	abstract = {We present a broadband X-ray study of the transient hyperluminous X-ray source (HLX), 2SXPS J111416.1+481833, in the galaxy NGC 3583, using archival XMM-Newton, NuSTAR, and Chandra data, and long-term Swift X-ray Telescope monitoring. The source episodically enters the hyperluminous regime with X-ray luminosities of LX {\textgreater} 1041 erg s−1 and drops by a factor {\textgreater}45 from its peak into a deep low state. We detect a clear spectral cutoff at ∼5–6 keV in the broadband spectra, which are well modeled by a soft thermal component combined with optically thick thermal Comptonization or an inner advection-dominated disk. In the XMM-Newton spectra, we detect a statistically significant (≳3.9σ) absorption line centered at Eline ≈ 1.97 ± 0.04 keV with a width of σline ≈ 74 ± 40 eV. We primarily interpret the line as a candidate proton cyclotron resonance scattering feature, implying a local magnetic field strength of B ∼ 4 × 1014 G. Alternative interpretations, such as an origin in an ionized outflow, were explored and found to be less likely. We do not detect coherent X-ray pulsations, placing 90\% confidence upper limits on the pulsed fraction of 19.3\% in the 0.3–10 keV band and 36.3\% in the 3–15 keV band. The combination of extreme luminosity, a hard spectral state, and the detection of a candidate cyclotron line provides strong evidence for a highly magnetized neutron star accretor.},
	language = {en},
	number = {1},
	urldate = {2026-10-09},
	journal = {The Astrophysical Journal},
	publisher = {The American Astronomical Society},
	author = {Jayasurya, Kiran M. and Upadhyay, Aman and Rana, Vikram},
	month = aug,
	year = {2026},
	pages = {32},
	file = {IOP Full Text PDF:/Users/kiranjayasurya/Zotero/storage/PHDQEWCH/Jayasurya et al. - 2026 - Discovery of a Candidate 2 keV Cyclotron Resonance Scattering Feature in the HLX NGC 3583 X-1.pdf:application/pdf},
}

